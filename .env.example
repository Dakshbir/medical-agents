# Copy this file to .env and fill in the keys you have.
# Groq (OpenAI-compatible API) - used for all non-Gemini "model" values
GROQ_API_KEY=

# Google AI Studio - used when --model contains "gemini"
GENAI_API_KEY=

# Optional: fast/cheap model used internally for difficulty-check and
# recruiter/meta agents (kept separate from the main --model so those
# quick decisions don't burn the more expensive model's quota).
FAST_MODEL=openai/gpt-oss-20b
